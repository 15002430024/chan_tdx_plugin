{====================================================}
{ 缠论综合买卖点指标                                 }
{ 文件名: 缠论买卖点.tn6                             }
{ 版本: 1.0.0                                        }
{ 说明: 显示所有买卖点（标准+准+类）                 }
{====================================================}

{调用DLL获取综合买卖信号}
BUYX:="CHAN.DLL"$CHAN_BUYX(HIGH,LOW,OPEN,CLOSE,VOL,AMOUNT,0);
SELLX:="CHAN.DLL"$CHAN_SELLX(HIGH,LOW,OPEN,CLOSE,VOL,AMOUNT,0);
BI_PRICE:="CHAN.DLL"$CHAN_BI(HIGH,LOW,OPEN,CLOSE,VOL,AMOUNT,0);
BPOS:=IF(BI_PRICE>0, BI_PRICE, LOW);
SPOS:=IF(BI_PRICE>0, BI_PRICE, HIGH);

{======================== 买点 ========================}

{标准一买 - 大红箭头}
B1:=BUYX=1;
DRAWICON(B1, BPOS, 1);
DRAWTEXT(B1, BPOS, '1买'), COLORRED;

{标准二买 - 橙色箭头}
B2:=BUYX=2;
DRAWICON(B2, BPOS, 13);
DRAWTEXT(B2, BPOS, '2买'), COLOR00AAFF;

{标准三买 - 黄色箭头}
B3:=BUYX=3;
DRAWICON(B3, BPOS, 14);
DRAWTEXT(B3, BPOS, '3买'), COLORYELLOW;

{准一买 - 小红点}
PB1:=BUYX=11;
DRAWICON(PB1, BPOS, 5);
DRAWTEXT(PB1, BPOS, '准1'), COLORFF8888;

{准二买}
PB2:=BUYX=12;
DRAWICON(PB2, BPOS, 5);
DRAWTEXT(PB2, BPOS, '准2'), COLORFF8888;

{准三买}
PB3:=BUYX=13;
DRAWICON(PB3, BPOS, 5);
DRAWTEXT(PB3, BPOS, '准3'), COLORFF8888;

{类二买A}
L2BA:=BUYX=21;
DRAWICON(L2BA, BPOS, 6);
DRAWTEXT(L2BA, BPOS, '类2A'), COLORMAGENTA;

{类二买AAA - 最强买点}
L2BAAA:=BUYX=22;
DRAWICON(L2BAAA, BPOS, 7);
DRAWTEXT(L2BAAA, BPOS, '类2★'), COLORMAGENTA;

{======================== 卖点 ========================}

{标准一卖 - 大绿箭头}
S1:=SELLX=-1;
DRAWICON(S1, SPOS, 2);
DRAWTEXT(S1, SPOS, '1卖'), COLORGREEN;

{标准二卖}
S2:=SELLX=-2;
DRAWICON(S2, SPOS, 12);
DRAWTEXT(S2, SPOS, '2卖'), COLORGREEN;

{标准三卖}
S3:=SELLX=-3;
DRAWICON(S3, SPOS, 15);
DRAWTEXT(S3, SPOS, '3卖'), COLORCYAN;

{准一卖 - 小绿点}
PS1:=SELLX=-11;
DRAWICON(PS1, SPOS, 4);
DRAWTEXT(PS1, SPOS, '准1'), COLOR88FF88;

{准二卖}
PS2:=SELLX=-12;
DRAWICON(PS2, SPOS, 4);
DRAWTEXT(PS2, SPOS, '准2'), COLOR88FF88;

{类二卖}
L2S:=SELLX<=-21 AND SELLX>=-22;
DRAWICON(L2S, SPOS, 8);
DRAWTEXT(L2S, SPOS, '类2'), COLORBLUE;
